@model Listing
@{
    var slug = ListingSlug.From(Model.Type);
    ViewData["Title"] = L[ListingSlug.AddAction(Model.Type)].Value;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-type="@slug">@L[ListingSlug.Heading(Model.Type)]</a></li>
        <li class="breadcrumb-item active">@L["New"]</li>
    </ol>
</nav>

<h1 class="h4 mb-4">@L[ListingSlug.AddAction(Model.Type)]</h1>

<form asp-action="Create" asp-route-type="@slug" method="post" enctype="multipart/form-data">
    <partial name="_Form" model="Model"/>
    <div class="mt-4">
        <button type="submit" class="btn btn-success">@L["Publish listing"]</button>
        <a class="btn btn-link" asp-action="Index" asp-route-type="@slug">@L["Cancel"]</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
