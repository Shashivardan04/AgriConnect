@model int

<li class="nav-item">
    <a class="nav-link text-white position-relative" asp-controller="Notifications" asp-action="Index"
       title="@L["Notifications"]">
        @L["Alerts"]
        @if (Model > 0)
        {
            <span class="badge rounded-pill bg-danger">@Model</span>
        }
    </a>
</li>
