@model List<Notification>
@{
    ViewData["Title"] = L["Notifications"].Value;
    var unread = Model.Count(n => !n.IsRead);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Notifications"]</h1>
    @if (unread > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button class="btn btn-sm btn-outline-secondary">@L["Mark all read ({0})", unread]</button>
        </form>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">@L["Nothing yet. Booking requests and decisions show up here."]</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <a class="list-group-item list-group-item-action @(n.IsRead ? "" : "list-group-item-light fw-semibold")"
               asp-action="Open" asp-route-id="@n.Id">
                <div class="d-flex justify-content-between">
                    @* Notification text is written when the event happens and stored
                       as it was then, so it stays in the language it was written in.
                       Translating it would need the message broken into a key and
                       its arguments at the point it is created, in BookingService. *@
                    <span>@n.Message</span>
                    <small class="text-muted ms-3 text-nowrap">@Dates.Moment(n.CreatedAt.ToLocalTime())</small>
                </div>
            </a>
        }
    </div>
}
