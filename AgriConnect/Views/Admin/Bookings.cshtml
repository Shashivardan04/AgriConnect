@model List<Booking>
@{ ViewData["Title"] = L["All bookings"].Value; }

<a class="small" asp-action="Index">&larr; @L["Administration"]</a>
<h1 class="h4 my-3">@L["All bookings"] <span class="text-muted fs-6">@L["(latest {0})", Model.Count]</span></h1>

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead class="table-light">
        <tr>
            <th>@L["Listing"]</th><th>@L["Requested by"]</th><th>@L["Dates"]</th>
            <th>@L["Status"]</th><th>@L["Raised"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>
                    @if (b.Listing is not null)
                    {
                        <a asp-controller="Listings" asp-action="Details"
                           asp-route-type="@ListingSlug.From(b.Listing.Type)" asp-route-id="@b.ListingId">@b.Listing.Title</a>
                    }
                </td>
                <td class="small">@b.Requester?.FullName</td>
                <td class="small">@Dates.Short(b.FromDate) &ndash; @Dates.Full(b.ToDate)</td>
                <td><span class="badge bg-light text-dark border">@L[b.Status.ToString()]</span></td>
                <td class="small text-muted">@Dates.Full(b.CreatedAt.ToLocalTime())</td>
            </tr>
        }
        </tbody>
    </table>
</div>
